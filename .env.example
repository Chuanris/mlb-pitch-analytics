# Local PostgreSQL development only. Replace this value before starting Compose.
MLB_POSTGRES_PASSWORD=replace-with-a-local-password
MLB_OLTP_DATABASE_URL=postgresql://mlb_app:replace-with-a-local-password@127.0.0.1:5432/mlb_operational

# dbt defaults. BigQuery uses Application Default Credentials, not a key in this file.
DBT_TARGET=duckdb
DBT_SCHEMA=dbt_mlb
DBT_THREADS=4
# DBT_BIGQUERY_PROJECT=replace-with-gcp-project
# DBT_BIGQUERY_LOCATION=US

# Local Airflow Docker development only. Generate unique values before use.
AIRFLOW_POSTGRES_PASSWORD=replace-with-a-local-airflow-password
AIRFLOW_JWT_SECRET=replace-with-a-random-local-jwt-secret
